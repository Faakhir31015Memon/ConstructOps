{
  "name": "constructops-backend",
  "version": "1.0.0",
  "description": "Backend API for ConstructOps - Construction Project Management SaaS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "install:frontend": "npm install --prefix ../frontend",
    "build": "npm run install:frontend && npm run build --prefix ../frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
