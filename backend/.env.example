
# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Replace with your local MongoDB or Atlas URL)
MONGO_URI=mongodb://127.0.0.1:27017/constructops_dev

# JWT Secret Key (Must be set, minimum 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_constructops_dev_2026

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:3000

# Copy to backend/.env for local development. On Vercel set these in Project Settings → Environment Variables.
DB_URI=mongodb://localhost:27017/constructops
JWT_SECRET=replace-with-a-long-random-string
PORT=5000


# Subscription Payment Gateway (EasyPaisa / JazzCash / Bank account shown to users at checkout)
EASYPAISA_NUMBER=03XX-XXXXXXX
JAZZCASH_NUMBER=03XX-XXXXXXX
BANK_NAME=Enter Bank Name
BANK_ACCOUNT_TITLE=Enter Account Title
BANK_ACCOUNT_NUMBER=Enter Account Number
