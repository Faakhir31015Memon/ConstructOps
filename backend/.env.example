# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (local MongoDB or Atlas URL)
DB_URI=mongodb://127.0.0.1:27017/constructops_dev

# JWT Secret Key (Must be set, minimum 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_constructops_dev_2026

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------
# Subscription payments (admin-verified manual flow works without these)
# ------------------------------------------------------------------
# ConstructOps receiving bank details shown at checkout
BANK_NAME=Meezan Bank
BANK_ACCOUNT_TITLE=ConstructOps (Pvt) Ltd
BANK_ACCOUNT_NUMBER=00000000000000
# Mobile wallet numbers shown for manual transfers
EASYPAISA_NUMBER=03XX-XXXXXXX
JAZZCASH_NUMBER=03XX-XXXXXXX

# Live JazzCash checkout (leave empty to keep the manual TID flow)
GATEWAY_JAZZCASH_STORE_ID=
GATEWAY_JAZZCASH_STORE_KEY=
GATEWAY_JAZZCASH_INITIATE_URL=
GATEWAY_RETURN_URL=

# Live Easypaisa checkout (leave empty to keep the manual TID flow)
GATEWAY_EASYPISA_STORE_ID=
GATEWAY_EASYPISA_HASH_KEY=
GATEWAY_EASYPISA_INITIATE_URL=

# Shared secret for POST /api/v1/billing/gateway/webhook/:provider (HMAC-SHA256)
GATEWAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# AI Assistant
# Leave ASSISTANT_API_KEY empty to use the built-in offline knowledge engine.
# Any OpenAI-compatible chat API works.
# ------------------------------------------------------------------
ASSISTANT_API_KEY=
ASSISTANT_API_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini

# System admin login (both required; admin login disabled if unset)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Sessions
# ------------------------------------------------------------------
# Access token lives 15 minutes; the rotating refresh token lasts REFRESH_TOKEN_DAYS.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# The system admin gets its own shorter-lived token.
ADMIN_JWT_EXPIRES_IN=2h
# How long a forgot-password link stays valid.
PASSWORD_RESET_TTL_MINUTES=30

# ------------------------------------------------------------------
# Email (password reset). Leave empty to keep resets dev-only:
# without SMTP the API returns the reset link in the response in
# development and simply reports "email not configured" in production.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ConstructOps <no-reply@constructops.pk>
# Public origin of the SPA, used for reset links and gateway return URLs.
APP_CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------
# WhatsApp daily site digest (Meta Cloud API). Leave empty to use the
# preview-only path in the UI.
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated fallback numbers when a site has none saved.
WHATSAPP_DIGEST_TO=
# 1 turns on the in-process evening scheduler (set on ONE server only).
DIGEST_AUTOMATIC=
# UTC hour the digest fires; 16:00 UTC = 21:00 PKT.
DIGEST_HOUR_UTC=16

# ------------------------------------------------------------------
# Invoice / receipt PDF letterhead
# ------------------------------------------------------------------
INVOICE_ISSUER=ConstructOps (Pvt) Ltd
INVOICE_ADDRESS_LINE1=ConstructOps SaaS Platform
INVOICE_ADDRESS_LINE2=Lahore, Pakistan
SUPPORT_EMAIL=support@constructops.pk

# ------------------------------------------------------------------
# Operations
# ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Backup folder (relative to backend/), how many to keep, and whether to
# copy the uploads/ photo folder into each backup.
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_UPLOADS=1
# Public base URL of this API, used by scripts/test-gateway-webhook.mjs.
APP_URL=http://localhost:5000
# Guard flags: demo seeding and production restore both refuse by default.
ALLOW_DEMO_SEED=
FORCE_RESTORE=

